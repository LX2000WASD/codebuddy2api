# Copy to .env for first use; preserve existing settings when updating.
# Compose and native launches read .env; native zero-configuration startup can omit it.

# Native listener and Compose host mapping; explicit --host/--port override native values.
CODEBUDDY2API_BIND=127.0.0.1
CODEBUDDY2API_PORT=8787

# Compose-only image and host data directory; container data stays in /data/auth.
CODEBUDDY2API_IMAGE=codebuddy2api:local
CODEBUDDY2API_AUTH_PATH=./auth

# Optional native data directory; Compose fixes CODEBUDDY_AUTH_DIR to /data/auth.
# CODEBUDDY_AUTH_DIR=./auth
# Import directory defaults to the data directory's imports/; use container paths in Compose.
# CODEBUDDY_IMPORT_DIR=./auth/imports

# Empty locks management; set a random key before exposing inference beyond loopback.
# Native: omit/comment the variable to use the saved default key (first local start displays it once).
CODEBUDDY2API_KEY=
# Native-only unsafe opt-in; Compose uses its host mapping to control exposure.
# CODEBUDDY2API_ALLOW_OPEN_NOAUTH=false

# Disabling CSRF checks does not disable authentication; use only on trusted local networks.
CODEBUDDY2API_ADMIN_CSRF=true

# Extra trusted management origins behind reverse proxies (comma separated; bare domains use HTTPS).
# Unset leaves the list configurable in the WebUI; an explicit value locks it.
# CODEBUDDY2API_ADMIN_ORIGINS=https://chat.example.com

# Unset leaves tool metadata configurable in the WebUI; an explicit Boolean locks it.
# CODEBUDDY2API_KEEP_TOOL_METADATA=true

# Image overflow keeps the newest blocks or returns 413; zero forbids all images.
CODEBUDDY2API_MAX_IMAGES=16
CODEBUDDY2API_IMAGE_POLICY=truncate
# Positive upstream JSON byte limit after image policy and protocol adaptation.
CODEBUDDY2API_MAX_REQUEST_BYTES=33554432
# Positive raw inbound byte limit, enforced before JSON parsing.
CODEBUDDY2API_MAX_INBOUND_BYTES=67108864
# Aggregated output bytes and concurrent inference requests; zero disables each limit.
CODEBUDDY2API_MAX_COLLECT_BYTES=8388608
CODEBUDDY2API_MAX_CONCURRENT=64
# Optional bounded upstream connection reuse; restart to apply, disabled by default.
# CODEBUDDY2API_UPSTREAM_KEEPALIVE=false
# Per-account in-flight limit; zero preserves unlimited account capacity.
# CODEBUDDY2API_MAX_INFLIGHT_PER_ACCOUNT=0
# Optional session/attempt tracing; legacy preserves existing upstream header behavior.
# CODEBUDDY2API_REQUEST_CONTEXT_MODE=legacy
# Responses projection is hot and WebUI-editable unless explicitly set here.
# balanced rewrites only recognized harness blocks with stable summaries; other text stays verbatim.
# 全量重放历史的客户端（DSH/pi-ai 等）必须设 passthrough,否则投影会截断工具输出导致 agent 死循环
# CODEBUDDY2API_RESPONSES_PROJECTION_MODE=balanced
# Per-item head/tail limit for generated assistant text, tool arguments and tool results;
# zero disables per-item trimming. Global request/output gates still apply.
# Non-zero values must be between 256 and 33554432 bytes.
# CODEBUDDY2API_RESPONSES_PROJECTION_MAX_BYTES=40000
# compatible preserves aggregation; realtime forwards all protocol output incrementally
# and does not regenerate malformed tool arguments.
# CODEBUDDY2API_STREAM_MODE=compatible
# Disable only declared model-capability preflight; other safeguards and Intl image merging remain enabled.
# CODEBUDDY2API_MODEL_CAPABILITY_GUARD=true

# Retired: this setting only warns; all persistent logs use logs.sqlite3.
CODEBUDDY2API_LOG=
# Legacy text-preview limit; text output is retired. SQLite diagnostics have a separate budget.
CODEBUDDY2API_LOG_BODY_LIMIT=65536

# International trial credits remain manual-only in the WebUI.
# Preauthorize first-Buddy tasks, one bounded chat (may use credits), adoption and travel.
CODEBUDDY2API_AUTO_ACCEPT_BUDDY=false

# Extra generations for malformed tool arguments; each may consume credits, zero disables retries.
CODEBUDDY2API_TOOL_CALL_MAX_RETRY=3
# Pre-response credential failovers; zero disables replay. See docs/advanced.md for billing risks.
CODEBUDDY2API_FAILOVER_MAX=0
# Replay incomplete writes only when partial requests cannot be billed upstream.
CODEBUDDY2API_RETRY_WRITE_TIMEOUT=false

# Upstream stream timeouts: read is the byte-gap fallback, TTFB bounds the wait before
# the first data line, idle bounds the gap between SSE lines. TTFB/idle failures can
# fail over to another credential before any response byte reaches the client. 0 disables.
CODEBUDDY2API_READ_TIMEOUT=300
CODEBUDDY2API_TTFB_TIMEOUT=45
CODEBUDDY2API_STREAM_IDLE_TIMEOUT=60

# Stream tool-bearing requests byte-by-byte instead of buffering them for validation
# and local retry of malformed tool_calls.
CODEBUDDY2API_STREAM_TOOLS=false

# Merge streamed reasoning into one client block (upstream v1.3.2 behavior; the client
# then measures a zero thinking duration). Set false to stream reasoning deltas live.
CODEBUDDY2API_COALESCE_REASONING=false

# Pin reasoning requests (reasoning_effort) to an explicit thinking switch for models
# whose names match any comma-separated substring. Long upstream conversations
# intermittently ignore reasoning_effort and leak chain-of-thought into content.
CODEBUDDY2API_THINKING_PIN_MODELS=deepseek

# ------------------------------------------------------------------
# Fusion 融合层（账号池调度与冷却，借鉴 workbuddy2api-panel）
# ------------------------------------------------------------------
# 模型级软冷却：429 按 账号×模型 隔离，文案带重置时间时对齐墙钟、切模型豁免；
# 与 11102 model_blocks（6h→24h 退避）正交。false 关闭整表。
# CODEBUDDY2API_MODEL_SOFT_COOLDOWN=true
# 429 文案未带重置时间时的模型冷却秒数，默认 600；封顶默认 86400。
# CODEBUDDY2API_MODEL_COOLDOWN=600
# CODEBUDDY2API_MODEL_COOLDOWN_MAX=86400
# 软冷却中的重复 429（重试/兜底探测）不延长截止、不推进计数，默认 true。
# CODEBUDDY2API_MODEL_COOLDOWN_NO_STACK=true
# 认证类错误（401/403）连续 N 次才禁用账号；单次只算抖动。refresh/chat 成功
# 或手工清零计数。默认 3 次，禁用时长默认 3600 秒。
# CODEBUDDY2API_AUTH_FAIL_THRESHOLD=3
# CODEBUDDY2API_AUTH_DISABLE_SECONDS=3600
# 账号级暂停：暂停选号但签到/旅行/保号任务照跑，与「停用」正交，管理面可切。
# CODEBUDDY2API_ACCOUNT_PAUSE=true
# 保号任务跨账号循环间休眠秒数（默认 0.8，对齐 panel travelAccountDelay；0 关闭）。
# CODEBUDDY2API_MAINTENANCE_ACCOUNT_GAP=0.8
# 积分保底：余额低于该值的账号不派发收费模型（本地 EMA 扣费台账 + 上游目录
# 倍率双判据，实测/声明免费的模型不受限）；全池触底返回 503 不打穿。默认 0 关闭。
# CODEBUDDY2API_CREDIT_FLOOR=0
# 扣费台账 EMA 平滑系数（默认 0.3）与观测有效期（默认 21600 秒=6 小时，
# 防跨时段复活，如限免窗口）。
# CODEBUDDY2API_CREDIT_FLOOR_COST_ALPHA=0.3
# CODEBUDDY2API_CREDIT_FLOOR_COST_TTL=21600
# 快过期积分加权选号：窗口（默认 604800 秒=168 小时）内有效批次权重 ×3，
# 软偏好——不破坏粘性与零倍率优先；window=0 或 weight=1 时退回原同 Rank 逻辑。
# CODEBUDDY2API_EXPIRING_CREDIT_WINDOW=604800
# CODEBUDDY2API_EXPIRING_CREDIT_WEIGHT=3

# ------------------------------------------------------------------
# Fusion 融合层（可观测性与告警，借鉴 workbuddy2api-panel）
# ------------------------------------------------------------------
# 告警总开关：事件始终记录历史，关闭时仅不投递通道。
# CODEBUDDY2API_ALERT_ENABLED=false
# 积分将到期提醒阈值（天）与日均需耗统计窗口（天）。
# CODEBUDDY2API_ALERT_CREDITS_EXPIRY_DAYS=3
# CODEBUDDY2API_ALERT_CREDITS_BURN_DAYS=7
# 同事件去重节流窗口（秒）：条件持续存在时节流后重发。
# CODEBUDDY2API_ALERT_THROTTLE_SECONDS=3600
# 告警事件历史最大条数（10..1000）。
# CODEBUDDY2API_ALERT_HISTORY_LIMIT=200
# 评估周期（秒，0 关闭周期评估；事件历史与手动投递不受影响）。
# CODEBUDDY2API_ALERT_EVALUATOR_INTERVAL_SECONDS=60
# 单次通道投递超时（秒）与重试次数（0..5）。
# CODEBUDDY2API_ALERT_TIMEOUT_SECONDS=10
# CODEBUDDY2API_ALERT_RETRY_COUNT=2
# tokens/s 口径：流式且首字节延迟 >= 该毫秒数时扣除 TTFB，否则回退端到端。
# tokens/s 扣除 TTFB 阈值（预留键：聚合当前固定 200ms，暂不生效，见 settings 注释）
# CODEBUDDY2API_STATS_TOKENS_RATE_TTFB_MS=200
# 服务身份（/healthz 响应体与 X-Service 头，防同端口残留服务假成功）。
# CODEBUDDY2API_HEALTH_SERVICE_NAME=codebuddy2api
